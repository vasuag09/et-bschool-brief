# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Free Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gmail account that SENDS the brief.
GMAIL_USER=youraddress@gmail.com

# Gmail App Password (16 chars, NOT your normal password).
# Requires 2-Step Verification ON: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Optional: override the recipient in config.yaml.
BRIEF_TO=
