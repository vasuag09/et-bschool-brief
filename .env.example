# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Amazon Bedrock API key (bearer token) — Bedrock console → API keys.
# Powers Claude Haiku 4.5 curation.
AWS_BEARER_TOKEN_BEDROCK=

# Optional Bedrock overrides (defaults: ap-south-1 runtime / global Haiku 4.5 profile).
# BEDROCK_REGION=ap-south-1
# BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Gmail account that SENDS the brief.
GMAIL_USER=youraddress@gmail.com

# Gmail App Password (16 chars, NOT your normal password).
# Requires 2-Step Verification ON: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Optional: override the recipient in config.yaml.
BRIEF_TO=
